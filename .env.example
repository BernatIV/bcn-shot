# Copia aquest fitxer a .env.local (no es commiteja) i omple els valors.

# Indexació per cercadors. Només "true" a la producció real de https://bcnshot.com.
# Qualsevol altre valor (o absent) => noindex + robots.txt amb Disallow.
ALLOW_INDEXING=false

# --- Formulari de contacte ---
# Proveïdor transaccional (PENDENT DE DECIDIR). Valors suportats: "resend".
# Sense proveïdor configurat, el formulari mostra un error amb l'enllaç mailto (no simula l'enviament).
MAIL_PROVIDER=
RESEND_API_KEY=

# Remitent autoritzat pel proveïdor i del domini (no fer spoofing), p. ex. "BCN SHOT <web@bcnshot.com>".
CONTACT_FROM_EMAIL=
# Destinatari de les consultes.
CONTACT_TO_EMAIL=info@bcnshot.com
